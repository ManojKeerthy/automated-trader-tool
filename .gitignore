# ==============================================================================
# TradeCraft .gitignore
# ==============================================================================

# ----- Secrets & Environment -----
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
parts/
var/
wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Testing
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter
.ipynb_checkpoints

# ----- Node / React -----
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/build/
dashboard/.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ----- Docker -----
docker-compose.override.yml

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Project Data (not source-controlled) -----
data/
logs/
backups/
tmp/
temp/

# ----- Database -----
*.db
*.sqlite3
pgdata/
