# ==============================================================================
# TradeCraft — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ==============================================================================

# ----- Application Mode -----
# PAPER or LIVE — defaults to PAPER if unset
TRADECRAFT_MODE=PAPER

# ----- Database -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradecraft
POSTGRES_USER=tradecraft
POSTGRES_PASSWORD=

# ----- Zerodha Kite Connect -----
# Do NOT fill these until M1+ when API subscription is active.
# See docs/BROKER_EXECUTION_POLICY.md for authentication flow.
KITE_API_KEY=
KITE_API_SECRET=

# ----- AI Providers -----
# Fill only the providers you intend to use.
# See docs/OBSERVABILITY.md for cost tracking.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# AI monthly budget ceiling in INR
AI_MONTHLY_BUDGET_INR=2500

# ----- Logging -----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ----- Data -----
DATA_DIR=./data

# ----- Timezone -----
# Used for market schedule logic. Do NOT change for Indian markets.
MARKET_TIMEZONE=Asia/Kolkata
